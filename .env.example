# ===== Database =====
POSTGRES_DB=familytree
POSTGRES_USER=familytree
POSTGRES_PASSWORD=change-me-strong-db-password

# 应用实际使用的连接串，必须与上面三项一致；密码含特殊字符需 URL 编码
DATABASE_URL=postgres://familytree:change-me-strong-db-password@db:5432/familytree

# ===== First-run admin (only used when the database is empty) =====
ADMIN_USER=admin
ADMIN_PASSWORD=admin

# ===== Default preview code (imported once if no code exists) =====
PREVIEW_CODE=welcome

# ===== Reverse proxy / HTTPS =====
# 只有放在会覆盖 X-Forwarded-For 的可信反代后面才设为 1
TRUST_PROXY=0
# 确认全站 HTTPS 后设为 1，Cookie 才会带 Secure
COOKIE_SECURE=0

# ===== Site =====
WEB_PORT=3001
TZ=Asia/Shanghai
